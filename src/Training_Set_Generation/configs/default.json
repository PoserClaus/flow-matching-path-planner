{
  "seed": 0,
  "n_scenes": 20,
  "out": "Test_Sets/default.npz",

  "car": {"radius": 0.3},

  "scene": {
    "type": "random_boxes_random_start",
    "params": {"n_boxes": [2, 6], "require_blocking": false}
  },

  "pairs": {
    "per_scene": 10,
    "min_dist": 3.0,
    "min_clearance": 0.4
  },

  "solver": {
    "type": "astar",
    "params": {
      "resolution": 0.1,
      "max_paths": 5,
      "min_path_distance": 0.5,
      "max_length_ratio": 1.5,
      "length_tau": 1.0,
      "safety_margin": 0.05
    }
  },

  "sensors": [
    {"type": "lidar", "params": {"n_beams": 360, "max_range": 8.0}},
    {"type": "imu"}
  ],

  "trajectory": {"n_points": 32}
}
